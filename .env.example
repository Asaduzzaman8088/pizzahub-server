# PizzaHub Server Environment Variables

# Server Port
PORT=5000
NODE_ENV=development

# Client Origin (CORS Whitelist)
CLIENT_URL=http://localhost:3000

# MongoDB Connection String (Atlas or Local)
# Local with auth: mongodb://<user>:<password>@127.0.0.1:27017/pizzahub?authSource=admin
MONGO_URI=mongodb://localhost:27017/pizzahubdb

# JWT Authentication Secret (used by the Express role middleware)
JWT_SECRET=pizzahub_jwt_secret_super_secure_key_change_in_production
JWT_EXPIRES_IN=7d

# Better Auth (credential + Google authentication)
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=another_super_secure_random_secret_change_in_production

# Seeded admin credentials (npm run seed)
ADMIN_EMAIL=admin@pizzahub.com
ADMIN_PASSWORD=Admin@123

# Stripe Payment & Webhook Secrets (Vendor Subscription)
STRIPE_SECRET_KEY=sk_test_51Pxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PREMIUM_PRICE_ID=price_xxxxxxxxxxxxxx

# Google OAuth Client ID (optional, matches frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
